<ServerManagerConfiguration>
  <ProxyGroup name="filters">
   <SourceProxy
     name="ttkComponentSize"
     class="ttkComponentSize"
     label="TTK ComponentSize">
     <Documentation
        long_help="TODO"
        short_help="TODO">
          TODO
     </Documentation>
     <InputProperty
        name="Input"
        command="SetInputConnection">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkDataSet"/>
        </DataTypeDomain>
        <InputArrayDomain attribute_type="point" name="point_arrays" number_of_components="1"/>
        <Documentation>
          Input data-set.
        </Documentation>
      </InputProperty>

      <StringVectorProperty name="IDs" label='IDs' command="SetInputArrayToProcess" element_types="0 0 0 0 2" number_of_elements="5">
        <ArrayListDomain name="array_list" input_domain_name="point_arrays">
          <RequiredProperties>
            <Property function="Input" name="Input" />
          </RequiredProperties>
        </ArrayListDomain>
        <Documentation>IDs.</Documentation>
      </StringVectorProperty>

      ${DEBUG_WIDGETS}

      <Hints>
        <ShowInMenu category="TTK - Misc" />
      </Hints>

   </SourceProxy>
 </ProxyGroup>
</ServerManagerConfiguration>
